typedef FlagRule =
{
  var flag:FeatureFlag;
  var resolve:Project->Bool;
}

typedef GitInfo =
{
  var branch:String;
  var commit:String;
  var shortHash:String;
  var modified:Bool;
}

typedef LibraryMismatch =
{
  var name:String;
  var devPath:String;
  var current:String;
  var expected:String;
  var type:String;
}

typedef AssetLibraryEntry =
{
  var name:String;
  var embed:Bool;
  var preload:Bool;
}

typedef IntentData =
{
  var name:String;
  var values:Array<String>;
}

