  static final FEATURE_3D_RENDERING:FeatureFlag = "FEATURE_3D_RENDERING";

  static final FEATURE_AWAY3D:FeatureFlag = "FEATURE_AWAY3D";

  static final FEATURE_NATIVE_CPP:FeatureFlag = "FEATURE_NATIVE_CPP";

  static var envConfig:Null<Map<String, Dynamic>> = null;

  static var astcExcludes:Array<String> = [];

  static var registeredFlags:Array<FeatureFlag> = [];

  static var cachedGitInfo:Null<GitInfo> = null;

  var assetOrigins:Map<String, String> = new Map<String, String>();

  public function new()
  {
    super();

    #if !target.unicode
    if (isWindowsHost())
    {
      Sys.command("chcp 65001 > nul");
    }
    #end

    envConfig = readEnvironmentFile(ENV_FILE);

    flair();

    displayTarget();

    configureApp();

    configureOutputDir();

    if (isRun() || isInstall())
    {
      return;
    }

    configureBuildEnvironment();
    configureFeatureFlags();
    configureWindowBackground();
    validateConfiguration();
    configureCompileDefines();
    configureIncludeMacros();
    configureCustomMacros();
    configureNativeCpp();
    configurePolymod();
    configureHaxelibs();
    configureASTCTextures();
    configureAssets();
    configureBuildInfo();

    if (!isLinux())
    {
      configureIcons();
    }

    if (FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this))
    {
      configureAdMobKeys();
    }

    if (FEATURE_GOOGLE_LOGIN.isEnabled(this))
    {
      configureGoogleKeys();
    }

    if (isAndroid())
    {
      configureAndroid();
    }

    if (isIOS())
    {
      configureIOS();
    }

    if (isCPP())
    {
      buildHxCppTools();
    }

    if (!(isDisplay() || isCleanCommand() || hasDefine("SKIP_LIBRARY_CHECK")))
    {
      checkLibraries();
    }
  }

  function flair():Void
  {
    var git:GitInfo = gitInfo();

    info("Friday Night Funkin' - " + VERSION);
    info("Moon Engine:    " + MOON_VERSION);
    info("Build Number:   " + BUILD_NUMBER);
    info("Initializing build...");

    info("Git Branch:     " + git.branch);
    info("Git Commit:     " + git.shortHash);
    info("Git Modified?   " + git.modified);
    info("Display?        " + isDisplay());
  }

  function configureApp():Void
  {
    this.meta.title = isMobile() ? TITLE_MOBILE : TITLE;

    this.meta.version = VERSION;
    this.meta.packageName = PACKAGE_NAME;
    this.meta.company = COMPANY;

    this.app.main = MAIN_CLASS;
    this.app.file = EXECUTABLE_NAME;
    this.app.preloader = PRELOADER;

    this.sources.push(SOURCE_DIR);

    this.templatePaths.push(TEMPLATES_DIR);

    this.preBuildCallbacks.push(buildHaxeCLICommand(PREBUILD_HX));
    this.postBuildCallbacks.push(buildHaxeCLICommand(POSTBUILD_HX));

    if (!hasDefine("NO_BUMP_BUILD") && FileSystem.exists(BUMP_SCRIPT))
    {
      this.preBuildCallbacks.push(buildCLICommand((isWindowsHost() ? "python" : "python3") + " " + BUMP_SCRIPT));
    }

    this.languages = LANGUAGES;

    this.meta.buildNumber = Std.string(BUILD_NUMBER);

    this.window.fps = 60;
    this.window.width = 1280;
    this.window.height = 720;
    this.window.background = 0xFF000000;

    this.window.hardware = true;
    this.window.vsync = false;
    this.window.allowHighDPI = !isMac();

    if (isWeb())
    {
      this.window.resizable = true;
    }

    if (isDesktop())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = false;
      this.window.resizable = true;
      this.window.vsync = false;
    }

    if (isMobile())
    {
      this.window.orientation = Orientation.LANDSCAPE;
      this.window.fullscreen = true;
      this.window.resizable = false;
      this.window.borderless = true;
      this.window.width = 0;
      this.window.height = 0;
    }

    if (isAndroid())
    {
      if (EXCLUDE_ARMV7.isEnabled(this))
      {
        this.excludeArchitectures.push(Architecture.ARMV7);
      }

      if (isRelease())
      {
        configureAndroidSigning();

        if (isBundle())
        {
          config.set("android.gradle-project-directory", "bin-bundle");
        }
      }
    }

    if (isIOS())
    {
      config.set("ios.non-exempt-encryption", "false");
      config.set("ios.team-id", envValue("TEAM_ID") ?? IOS_TEAM_ID);
      config.set("ios.deployment", "16.0");
    }
  }

  function configureAndroidSigning():Void
  {
    var keystorePath:Null<String> = envValue('KEYSTORE_PATH');
    var keystoreAlias:Null<String> = envValue('KEYSTORE_ALIAS');
    var keystorePassword:Null<String> = envValue('KEYSTORE_PASSWORD');

    if (keystorePath != null && keystoreAlias != null && keystorePassword != null)
    {
      keystore = new Keystore();
      keystore.path = keystorePath;
      keystore.alias = keystoreAlias;
      keystore.password = keystorePassword;
    }
  }

  function configureWindowBackground():Void
  {
    this.window.background = FEATURE_DEBUG_FUNCTIONS.isEnabled(this) ? 0xFFFF00FF : 0xFF000000;
  }

  function configureBuildEnvironment():Void
  {
    for (key in PASSTHROUGH_ENV_KEYS)
    {
      var value:Null<String> = envValue(key);

      if (value != null && Sys.getEnv(key) == null)
      {
        setenv(key, value);
      }
    }
  }

  function displayTarget():Void
  {
    switch (this.target)
    {
      case Platform.WINDOWS:
        info('Target Platform: Windows');
      case Platform.MAC:
        info('Target Platform: MacOS');
      case Platform.LINUX:
        info('Target Platform: Linux');
      case Platform.ANDROID:
        info('Target Platform: Android');
      case Platform.IOS:
        info('Target Platform: IOS');
      case Platform.HTML5:
        info('Target Platform: HTML5');
      default:
        error('Unsupported platform (got ${target})');
    }

    switch (this.platformType)
    {
      case PlatformType.DESKTOP:
        info('Target Platform Type: Desktop');
      case PlatformType.MOBILE:
        info('Target Platform Type: Mobile');
      case PlatformType.WEB:
        info('Target Platform Type: Web');
      case PlatformType.CONSOLE:
        info('Target Platform Type: Console');
      default:
        error('Unknown platform type (got ${platformType})');
    }

    if (isWeb())
    {
      info('Target Language: JavaScript (HTML5)');
    }
    else if (isCPP())
    {
      info('Target Language: C++');
    }
    else
    {
      error('Unsupported target language!');
    }

    info('Build Mode: ' + (isDebug() ? 'Debug' : 'Release'));

    for (arch in this.architectures)
    {
      switch (arch)
      {
        case Architecture.X86:
          info('Target Architecture: x86');
        case Architecture.X64:
          info('Target Architecture: x64');
        case Architecture.ARMV7:
          info('Target Architecture: ARMv7');
        case Architecture.ARM64:
          info('Target Architecture: ARM64');
        case null:
          if (!isWeb())
          {
            error('Unsupported architecture (got null on non-web platform)');
          }
          else
          {
            info('Target Architecture: Web');
          }
        default:
          error('Unsupported architecture (got ${arch})');
      }
    }
  }

  static function flagRule(flag:FeatureFlag, resolve:Project->Bool):FlagRule
  {
    return {flag: flag, resolve: resolve};
  }

  function buildFlagRules():Array<FlagRule>
  {
    return [
      flagRule(GITHUB_BUILD, _ -> false),
      flagRule(EXCLUDE_ARMV7, _ -> false),
      flagRule(HARDCODED_CREDITS, _ -> true),
      flagRule(UNLOCK_EVERYTHING, _ -> true),
      flagRule(EMBED_ASSETS, p -> p.isWeb()),
      flagRule(PRELOAD_ALL, p -> !p.isWeb()),
      flagRule(FEATURE_DEBUG_FUNCTIONS, p -> p.isDebug() || GITHUB_BUILD.isEnabled(p)),
      flagRule(FEATURE_RESULTS_DEBUG, p -> p.isDebug() || GITHUB_BUILD.isEnabled(p)),
      flagRule(FEATURE_DEBUG_TRACY, _ -> false),
      flagRule(REDIRECT_ASSETS_FOLDER, p -> p.isDebug() && p.isDesktop()),
      flagRule(CENSOR_EXPLETIVES, p -> p.isMobile()),
      flagRule(FORCE_BLEND_SHADER, p -> p.isAndroid()),
      flagRule(FEATURE_FUNKVIS, _ -> true),
      flagRule(FEATURE_LOG_TRACE, _ -> true),
      flagRule(FEATURE_DEBUG_FILE_LOGGING, p -> FEATURE_DEBUG_FUNCTIONS.isEnabled(p)),
      flagRule(FEATURE_NAUGHTYNESS, _ -> true),
      flagRule(FEATURE_OPEN_URL, _ -> true),
      flagRule(FEATURE_PARTIAL_SOUNDS, _ -> true),
      flagRule(FEATURE_POLYMOD_MODS, _ -> true),
      flagRule(FEATURE_LUA_SCRIPTS, _ -> true),
      flagRule(FEATURE_MOON_SCRIPTS, _ -> true),
      flagRule(FEATURE_MOD_MENU, _ -> false),
      flagRule(FEATURE_MOD_LOADING, _ -> false),
      flagRule(FEATURE_VIDEO_PLAYBACK, _ -> true),
      flagRule(FEATURE_VIDEO_SUBTITLES, p -> FEATURE_VIDEO_PLAYBACK.isEnabled(p) && !p.isWeb()),
      flagRule(FEATURE_DISCORD_RPC, p -> p.isDesktop() && !FEATURE_DEBUG_FUNCTIONS.isEnabled(p)),
      flagRule(FEATURE_HXRPC, p -> p.isDesktop() || p.isMobile()),
      flagRule(FEATURE_LOST_FOCUS_VOLUME, p -> p.isDesktop()),
      flagRule(FEATURE_NEWGROUNDS, _ -> true),
      flagRule(FEATURE_NEWGROUNDS_DEBUG, _ -> false),
      flagRule(FEATURE_NEWGROUNDS_TESTING_MEDALS, p -> FEATURE_NEWGROUNDS.isEnabled(p) && FEATURE_DEBUG_FUNCTIONS.isEnabled(p)),
      flagRule(FEATURE_NEWGROUNDS_AUTOLOGIN, p -> FEATURE_NEWGROUNDS.isEnabled(p) && p.isWeb()),
      flagRule(FEATURE_NEWGROUNDS_EVENTS, p -> FEATURE_NEWGROUNDS.isEnabled(p)),
      flagRule(FEATURE_GOOGLE_LOGIN, p -> p.isDesktop() || p.isAndroid()),
      flagRule(FEATURE_DEBUG_MENU, p -> !p.isWeb()),
      flagRule(FEATURE_ANIMATION_EDITOR, p -> !p.isWeb()),
      flagRule(FEATURE_CHART_EDITOR, p -> !p.isWeb()),
      flagRule(FEATURE_STAGE_EDITOR, p -> !p.isWeb()),
      flagRule(FEATURE_MUSIC_EDITOR, p -> !p.isWeb()),
      flagRule(FEATURE_HAXEUI,
        p -> FEATURE_ANIMATION_EDITOR.isEnabled(p) || FEATURE_CHART_EDITOR.isEnabled(p) || FEATURE_STAGE_EDITOR.isEnabled(p)),
      flagRule(FEATURE_LAG_ADJUSTMENT, p -> !p.isWeb()),
      flagRule(FEATURE_SCREENSHOTS, p -> p.isDesktop()),
      flagRule(FEATURE_FILE_DROP, p -> !p.isMobile()),
      flagRule(FEATURE_TOUCH_HERE_TO_PLAY, p -> p.isWeb()),
      flagRule(FEATURE_HAPTICS, p -> p.isMobile()),
      flagRule(FEATURE_TOUCH_CONTROLS, p -> p.isMobile()),
      flagRule(FEATURE_MOBILE_ADVERTISEMENTS, p -> p.isMobile() && p.isRelease() && p.hasEnvironment()),
      flagRule(TESTING_ADS, p -> p.isDebug() && FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(p)),
      flagRule(FEATURE_MOBILE_IAP, p -> p.isMobile() && p.isRelease() && p.hasEnvironment()),
      flagRule(FEATURE_MOBILE_IAR, p -> p.isMobile() && p.isRelease()),
      flagRule(FEATURE_MOBILE_WEBVIEW, p -> p.isMobile() && FEATURE_NEWGROUNDS.isEnabled(p)),
      flagRule(FEATURE_MOBILE_AGESIGNALS, p -> p.isMobile() && p.isRelease()),
      flagRule(FEATURE_GHOST_TAPPING, p -> p.isMobile()),
      flagRule(FEATURE_COMPRESSED_TEXTURES, p -> p.isMobile() && p.isRelease() && !p.isIOSSimulator()),
      flagRule(FEATURE_DEBUG_DISPLAY, p -> !p.isMobile() || FEATURE_DEBUG_FUNCTIONS.isEnabled(p)),
      flagRule(FEATURE_ONLINE, _ -> false),
      flagRule(FEATURE_3D_RENDERING, _ -> false),
      flagRule(FEATURE_AWAY3D, _ -> false),
      flagRule(FEATURE_NATIVE_CPP, _ -> false)
    ];
  }

  function configureFeatureFlags():Void
  {
    var rules:Array<FlagRule> = buildFlagRules();

    registeredFlags = [for (rule in rules) rule.flag];

    for (rule in rules)
    {
      rule.flag.apply(this, rule.resolve(this));
    }

    renderFlagsTable();
  }

  function validateConfiguration():Void
  {
    if (FEATURE_ONLINE.isEnabled(this))
    {
      warn("FEATURE_ONLINE is enabled but the online server is currently offline.");
    }

    if (FEATURE_3D_RENDERING.isEnabled(this))
    {
      warn("FEATURE_3D_RENDERING is enabled: the Foxlite FoxExtendableSprite/FoxScene chain conflicts with ScriptedFlxSprite and may fail with 'Redefinition of variable _asc'.");
    }

    if (FEATURE_AWAY3D.isEnabled(this))
    {
      warn("FEATURE_AWAY3D is enabled: Away3D 5.0.9 expects Lib.getTimer() to return Int/UInt, which breaks View3D, ParserBase and AnimatorBase on current OpenFL.");
    }

    if (FEATURE_COMPRESSED_TEXTURES.isEnabled(this) && !isMobile())
    {
      warn("FEATURE_COMPRESSED_TEXTURES is enabled on a non-mobile target.");
    }

    if (isAndroid() && isRelease() && keystore == null)
    {
      warn("Release build for Android without a configured keystore; the package will not be signed for distribution.");
    }

    if (isIOS() && (envValue("TEAM_ID") ?? IOS_TEAM_ID) == "")
    {
      warn("iOS build without a team id; set IOS_TEAM_ID in the .env file.");
    }
  }

  function collectFeatureFlags():{enabled:Array<String>, disabled:Array<String>}
  {
    var enabled:Array<String> = [];
    var disabled:Array<String> = [];

    for (flag in registeredFlags)
    {
      if (flag.isEnabled(this))
      {
        enabled.push(flag);
      }
      else
      {
        disabled.push(flag);
      }
    }

    enabled.sort(Reflect.compare);
    disabled.sort(Reflect.compare);

    return {enabled: enabled, disabled: disabled};
  }

  function renderFlagsTable():Void
  {
    var flags = collectFeatureFlags();

    var checkMark:String = "✓ ";
    var crossMark:String = "× ";
    var enabledTitle:String = "Enabled Flags";
    var disabledTitle:String = "Disabled Flags";

    var enabledWidth:Int = enabledTitle.length;
    var disabledWidth:Int = disabledTitle.length;

    for (name in flags.enabled)
    {
      enabledWidth = Std.int(Math.max(enabledWidth, name.length));
    }

    for (name in flags.disabled)
    {
      disabledWidth = Std.int(Math.max(disabledWidth, name.length));
    }

    var divider:String = "".rpad("-", enabledWidth + disabledWidth + 7);

    info(divider);
    info("FEATURE FLAGS (" + flags.enabled.length + " enabled, " + flags.disabled.length + " disabled)");
    info("  " + enabledTitle.rpad(" ", enabledWidth) + " |   " + disabledTitle);
    info(divider);

    var rows:Int = Std.int(Math.max(flags.enabled.length, flags.disabled.length));

    for (i in 0...rows)
    {
      var left:String = i < flags.enabled.length ? checkMark + flags.enabled[i].rpad(" ", enabledWidth) : "".rpad(" ", enabledWidth + 2);
      var right:String = i < flags.disabled.length ? crossMark + flags.disabled[i] : "";

      info(left + " | " + right);
    }

    info(divider);
  }

  function configureCompileDefines():Void
  {
    setHaxedef("funkin", VERSION);
    setHaxedef("moon", MOON_VERSION);

    setHaxedef("openfl-enable-handle-error");

    setHaxedef("lime_disable_assets_version");

    setHaxedef("HXCPP_CHECK_POINTER");
    setHaxedef("HXCPP_STACK_LINE");
    setHaxedef("HXCPP_STACK_TRACE");
    setHaxedef("hscriptPos");

    if (FEATURE_DEBUG_FUNCTIONS.isDisabled(this))
    {
      setHaxedef("FLX_NO_DEBUG");
      setHaxedef("analyzer-optimize");
    }

    if (FEATURE_LOG_TRACE.isDisabled(this))
    {
      setHaxedef("no-traces");
    }

    setHaxedef("FLX_NO_FOCUS_LOST_SCREEN");

    setHaxedef("haxeui_no_mouse_reset");
    setHaxedef("haxeui_focus_out_on_click");
    setHaxedef("haxeui_dont_impose_base_class");

    if (isRelease())
    {
      setHaxedef("NAPE_RELEASE_BUILD");
    }

    setHaxedef("message.reporting", "pretty");

    if (FEATURE_DEBUG_TRACY.isEnabled(this))
    {
      setHaxedef("HXCPP_TELEMETRY");
      setHaxedef("HXCPP_TRACY");
      setHaxedef("HXCPP_TRACY_MEMORY");
      setHaxedef("HXCPP_TRACY_ON_DEMAND");

      setHaxedef("absolute-paths");
    }
  }

  function configureIncludeMacros():Void
  {
    addHaxeFlag("-dce no");

    addHaxeMacro("include('funkin', true, ['funkin.mobile.*', 'funkin.ui.debug.anim.*', 'funkin.ui.debug.charting.*', 'funkin.ui.debug.stage.*', 'funkin.ui.debug.stageeditor.*', 'funkin.ui.haxeui.*'])");

    if (isMobile())
    {
      addHaxeMacro("include('funkin.mobile')");
    }

    if (FEATURE_HAXEUI.isEnabled(this))
    {
      if (FEATURE_ANIMATION_EDITOR.isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.anim')");
      }

      if (FEATURE_CHART_EDITOR.isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.charting')");
      }

      if (FEATURE_STAGE_EDITOR.isEnabled(this))
      {
        addHaxeMacro("include('funkin.ui.debug.stage')");
        addHaxeMacro("include('funkin.ui.debug.stageeditor')");
      }

      addHaxeMacro("include('funkin.ui.haxeui')");

      addHaxeMacro("include('haxe.ui.backend.flixel.components')");
      addHaxeMacro("include('haxe.ui.core')");
      addHaxeMacro("include('haxe.ui.components')");
      addHaxeMacro("include('haxe.ui.containers')");
      addHaxeMacro("include('haxe.ui.containers.dialogs')");
      addHaxeMacro("include('haxe.ui.containers.menus')");
      addHaxeMacro("include('haxe.ui.containers.properties')");
    }

    addHaxeMacro("include('animate')");

    addHaxeMacro("include('openfl')");

    addHaxeMacro("include('lime', true, ['lime.tools.*', 'lime._internal.*'])");

    addHaxeMacro("include('flixel', true, [ 'flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*', 'flixel.addons.tile.FlxRayCastTilemap' ])");
  }

  function configureCustomMacros():Void
  {
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxBasic())', 'flixel.FlxBasic')");
    addHaxeMacro("addMetadata('@:build(funkin.util.macro.FlxMacro.buildFlxSprite())', 'flixel.FlxSprite')");
  }

  function configureNativeCpp():Void
  {
    if (!FEATURE_NATIVE_CPP.isEnabled(this)) return;

    if (!isCPP())
    {
      warn('FEATURE_NATIVE_CPP is enabled but the current target does not compile to C++; skipping native bridge inclusion.');
      return;
    }

    if (!FileSystem.exists(NATIVE_CPP_DIR))
    {
      FileSystem.createDirectory(NATIVE_CPP_DIR);
      info('Created native C++ bridge directory at $NATIVE_CPP_DIR.');
    }

    addHaxeMacro("include('funkin.native')");

    info('Native C++ support enabled. Place extern classes under $NATIVE_CPP_DIR using @:buildXml and @:include metadata to compile custom .cpp/.h sources into the build.');
  }

  function configureOutputDir():Void
  {
    var buildDir:String = 'export/${isDebug() ? 'debug' : 'release'}';

    if (FEATURE_DEBUG_TRACY.isEnabled(this)) buildDir += "-tracy";

    info('Output directory: $buildDir');

    buildDir += "/";

    app.path = buildDir;
  }

  static function createElement(name:String, ?attributes:Map<String, String>, ?children:Array<Xml>):Xml
  {
    var element:Xml = Xml.createElement(name);

    if (attributes != null)
    {
      for (key => value in attributes)
      {
        element.set(key, value);
      }
    }

    if (children != null)
    {
      for (child in children)
      {
        element.addChild(child);
      }
    }

    return element;
  }

  @:nullSafety(Off)
  function appendConfigXml(key:String, xml:Xml):Void
  {
    var target:Dynamic = config.get(key);

    if (target == null)
    {
      warn('Config section "$key" does not exist; skipping XML injection.');
      return;
    }

    var printed:String = Printer.print(xml, true);

    if (target.xmlChildren != null)
    {
      target.xmlChildren.push(printed);
    }
    else
    {
      target.xmlChildren = [printed];
    }
  }

  function collectFnfcIntentData():Array<IntentData>
  {
    var patterns:Array<String> = [];

    for (depth in 0...FNFC_PATTERN_DEPTH)
    {
      var pattern:String = "";

      for (segment in 0...(depth + 1))
      {
        pattern += ".*\\.";
      }

      patterns.push(pattern + "fnfc");
    }

    return [
      {name: "android:mimeType", values: ["application/zip"]},
      {name: "android:scheme", values: ["file", "content"]},
      {name: "android:pathPattern", values: patterns}
    ];
  }

  function configureAndroid():Void
  {
    javaPaths.push(Path.join([SOURCE_DIR, 'funkin/external/android/java']));

    var documentsAction:Xml = createElement('action', ['android:name' => 'android.content.action.DOCUMENTS_PROVIDER']);
    var documentsFilter:Xml = createElement('intent-filter', null, [documentsAction]);

    var folderProvider:Xml = createElement('provider', [
      'android:authorities' => '$PACKAGE_NAME.docprovider',
      'android:name' => 'funkin.provider.DataFolderProvider',
      'android:grantUriPermissions' => 'true',
      'android:exported' => 'true',
      'android:permission' => 'android.permission.MANAGE_DOCUMENTS'
    ], [documentsFilter]);

    appendConfigXml('android.application', folderProvider);

    var viewFilter:Xml = createElement('intent-filter');
    viewFilter.addChild(createElement('action', ['android:name' => 'android.intent.action.VIEW']));

    for (categoryName in ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"])
    {
      viewFilter.addChild(createElement('category', ['android:name' => categoryName]));
    }

    for (intentData in collectFnfcIntentData())
    {
      for (value in intentData.values)
      {
        viewFilter.addChild(createElement('data', [intentData.name => value]));
      }
    }

    appendConfigXml('android.activity', viewFilter);

    if (FEATURE_GOOGLE_LOGIN.isEnabled(this))
    {
      config.push("android.permission", "android.permission.INTERNET");
      config.push("android.permission", "android.permission.GET_ACCOUNTS");
    }

    var extensions:Null<Array<String>> = config.getArrayString('android.extension');

    for (extension in ANDROID_EXTENSIONS)
    {
      if (extensions == null || extensions.indexOf(extension) == -1)
      {
        config.push("android.extension", extension);
      }
    }
  }

  @:nullSafety(Off)
  function configureIOS():Void
  {
    if (!FileSystem.exists(DOCUMENT_TYPES_FILE))
    {
      warn('$DOCUMENT_TYPES_FILE was not found; .fnfc file association will be unavailable on iOS.');
      return;
    }

    var documentTypes:String = File.getContent(DOCUMENT_TYPES_FILE);
    var existing:Array<String> = config.getArrayString('ios.info-plist-children');

    config.set('ios.info-plist-children', existing != null ? existing.concat([documentTypes]) : [documentTypes]);
  }

  function configurePolymod():Void
  {
    setHaxedef("POLYMOD_SCRIPT_EXT", ".hscript");
    setHaxedef("POLYMOD_SCRIPT_LIBRARY", "scripts");
    setHaxedef("POLYMOD_ROOT_PATH", "scripts/");
    setHaxedef("POLYMOD_APPEND_FOLDER", "_append");
    setHaxedef("POLYMOD_MERGE_FOLDER", "_merge");
    setHaxedef("POLYMOD_MOD_METADATA_FILE", "_polymod_meta.json");
    setHaxedef("POLYMOD_MOD_ICON_FILE", "_polymod_icon.png");

    if (isDebug())
    {
      setHaxedef("POLYMOD_DEBUG");
    }
  }

  function addHaxelibsIf(condition:Bool, names:Array<String>):Void
  {
    if (!condition) return;

    for (name in names)
    {
      addHaxelib(name);
    }
  }

  function configureHaxelibs():Void
  {
    addHaxelibsIf(true, ['flixel', 'flixel-addons', 'polymod', 'flixel-animate']);
    addHaxelibsIf(FEATURE_HAXEUI.isEnabled(this), ['haxeui-core', 'haxeui-flixel']);
    addHaxelibsIf(FEATURE_3D_RENDERING.isEnabled(this), ['foxlite']);
    addHaxelibsIf(FEATURE_AWAY3D.isEnabled(this), ['away3d']);
    addHaxelibsIf(FEATURE_LUA_SCRIPTS.isEnabled(this), ['hxlua']);
    addHaxelibsIf(true, ['json2object', 'jsonpath', 'jsonpatch', 'thx.core', 'thx.semver']);
    addHaxelibsIf(isDebug() && isCPP(), ['hxcpp-debug-server']);
    addHaxelibsIf((isDesktop() || isMobile()) && FEATURE_VIDEO_PLAYBACK.isEnabled(this), ['hxvlc']);
    addHaxelibsIf(isAndroid(), ['extension-androidtools']);
    addHaxelibsIf(isLinux(), ['hxgamemode']);
    addHaxelibsIf(FEATURE_DISCORD_RPC.isEnabled(this), ['hxdiscord_rpc']);
    addHaxelibsIf(FEATURE_HXRPC.isEnabled(this), ['hxrpc']);
    addHaxelibsIf(FEATURE_NEWGROUNDS.isEnabled(this), ['newgrounds']);
    addHaxelibsIf(FEATURE_FUNKVIS.isEnabled(this), ['funkin.vis', 'grig.audio']);
    addHaxelibsIf(FEATURE_PARTIAL_SOUNDS.isEnabled(this), ['FlxPartialSound']);
    addHaxelibsIf(FEATURE_HAPTICS.isEnabled(this), ['extension-haptics']);
    addHaxelibsIf(FEATURE_MOBILE_ADVERTISEMENTS.isEnabled(this), ['extension-admob']);
    addHaxelibsIf(FEATURE_MOBILE_IAP.isEnabled(this), ['extension-iapcore']);
    addHaxelibsIf(FEATURE_MOBILE_IAR.isEnabled(this), ['extension-iarcore']);
    addHaxelibsIf(FEATURE_MOBILE_WEBVIEW.isEnabled(this), ['extension-webviewcore']);
    addHaxelibsIf(FEATURE_MOBILE_AGESIGNALS.isEnabled(this), ['extension-agesignals']);
  }

  function collectAssetLibraries(shouldEmbed:Bool, shouldPreload:Bool):Array<AssetLibraryEntry>
  {
    var libraries:Array<AssetLibraryEntry> = [
      {name: "songs", embed: shouldEmbed, preload: shouldPreload},
      {name: "shared", embed: shouldEmbed, preload: shouldPreload}
    ];

    if (FEATURE_VIDEO_PLAYBACK.isEnabled(this))
    {
      libraries.push({name: "videos", embed: false, preload: shouldPreload});
    }

    for (name in CONTENT_LIBRARIES)
    {
      libraries.push({name: name, embed: shouldEmbed, preload: shouldPreload});
    }

    return libraries;
  }

  function addOptionalAsset(path:String, rename:String, library:String):Void
  {
    if (FileSystem.exists(path))
    {
      addAsset(path, rename, library, false);
    }
    else
    {
      warn('Optional asset "$path" was not found; skipping.');
    }
  }

  function removeDisabledEditorAssets():Void
  {
    if (!FEATURE_ANIMATION_EDITOR.isEnabled(this)) removeAssetPath('assets/preload/data/ui/animation-editor', "default");

    if (!FEATURE_CHART_EDITOR.isEnabled(this)) removeAssetPath('assets/preload/data/ui/chart-editor', "default");

    if (!FEATURE_STAGE_EDITOR.isEnabled(this)) removeAssetPath('assets/preload/data/ui/stage-editor', "default");
  }

  function configureAssets():Void
  {
    if (!(isDisplay() || isCleanCommand()))
    {
      clearAssets();
    }

    var exclude:Array<String> = EXCLUDE_ASSETS.concat(isWeb() ? EXCLUDE_ASSETS_WEB : EXCLUDE_ASSETS_NATIVE);
    exclude = exclude.concat(CENSOR_EXPLETIVES.isEnabled(this) ? EXCLUDE_ASSETS_CENSORED : EXCLUDE_ASSETS_UNCENSORED);

    var shouldPreload:Bool = PRELOAD_ALL.isEnabled(this);
    var shouldEmbed:Bool = EMBED_ASSETS.isEnabled(this);

    info(shouldEmbed ? 'Embedding assets into executable...' : 'Including assets alongside executable...');

    addAssetLibrary("default", shouldEmbed, true);
    addAssetPath("assets/preload", "assets", "default", ["*"], exclude, shouldEmbed, "assets");

    if (!HARDCODED_CREDITS.isEnabled(this))
    {
      addAsset("assets/exclude/data/credits.json", "assets/data/credits.json", "default", shouldEmbed);
    }

    removeDisabledEditorAssets();

    addAssetPath("assets/fonts", null, "default", ["*"], exclude, true, "assets");

    for (entry in collectAssetLibraries(shouldEmbed, shouldPreload))
    {
      var libraryPath:String = 'assets/${entry.name}';

      addAssetLibrary(entry.name, entry.embed, entry.preload);
      addAssetPath(libraryPath, libraryPath, entry.name, ["*"], exclude, entry.embed, "assets");
    }

    for (song in EMBED_SONGS_AUDIO)
    {
      var songPath:String = 'assets/songs/$song';

      removeAssetPath(songPath, "songs");
      addAssetPath(songPath, songPath, "songs", ["*"], exclude, true, "assets");
    }

    addAssetLibrary("art", false, false);
    addOptionalAsset("art/readme.txt", "do NOT readme.txt", "art");
    addOptionalAsset("LICENSE.md", "LICENSE.md", "art");
    addOptionalAsset("CHANGELOG.md", "CHANGELOG.md", "art");

    info(shouldEmbed ? 'Done embedding assets.' : 'Done including assets.');
  }

  function clearAssets():Void
  {
    if (!isBuild()) return;

    var exportPath:String = app.path ?? "";

    var platform:String = !isMac() ? Std.string(this.target) : 'macos';
    var basePath:String = Path.join([exportPath, platform, "bin"]);
    var assetsPath:String = "";

    switch (platformType)
    {
      case PlatformType.DESKTOP:
        if (isMac())
        {
          assetsPath = Path.join([basePath, '${this.app.file}.app', "Contents", "Resources", "assets"]);
        }
        else
        {
          assetsPath = Path.join([basePath, "assets"]);
        }
      case PlatformType.MOBILE:
        if (isAndroid() && !isBundle())
        {
          assetsPath = Path.join([basePath, "app", "src", "main", "assets", "assets"]);
        }
        else if (isIOS())
        {
          assetsPath = Path.join([exportPath, platform, '${this.app.file}', "assets", "assets"]);
        }
        else
        {
          return;
        }
      default:
        return;
    }

    if (FileSystem.exists(assetsPath))
    {
      info('Deleting assets folder from export folder ($assetsPath)');

      deleteDirectoryRecursive(assetsPath);
    }
    else
    {
      info('Assets folder does not exist ($assetsPath)');
    }
  }

  function deleteDirectoryRecursive(path:String):Void
  {
    if (!FileSystem.exists(path)) return;

    for (file in FileSystem.readDirectory(path))
    {
      var fullPath:String = Path.join([path, file]);

      if (FileSystem.isDirectory(fullPath))
      {
        deleteDirectoryRecursive(fullPath);
      }
      else
      {
        FileSystem.deleteFile(fullPath);
      }
    }

    FileSystem.deleteDirectory(path);
  }

  static function stableBuildInfo(json:String):String
  {
    var data:Dynamic = haxe.Json.parse(json);
    Reflect.deleteField(data, "builtAt");
    return haxe.Json.stringify(data);
  }

  function configureBuildInfo():Void
  {
    info('Embedding build info...');

    var git:GitInfo = gitInfo();
    var flags = collectFeatureFlags();

    var buildInfo =
      {
        commit: git.shortHash,
        branch: git.branch,
        buildType: isDebug() ? 'debug' : 'release',
        platform: targetPlatformName(),
        builtAt: Date.now().toString(),
        engineVersion: VERSION,
        moonVersion: MOON_VERSION,
        buildNumber: BUILD_NUMBER,
        enabledFeatures: flags.enabled
      };

    var outputPath:String = Path.join([BUILD_INFO_DIR, BUILD_INFO_FILE]);
    var content:String = haxe.Json.stringify(buildInfo, null, '  ');

    try
    {
      if (FileSystem.exists(outputPath) && stableBuildInfo(File.getContent(outputPath)) == stableBuildInfo(content))
      {
        info('  Build info is up to date ($outputPath)');
        return;
      }

      if (!FileSystem.exists(BUILD_INFO_DIR)) FileSystem.createDirectory(BUILD_INFO_DIR);

      File.saveContent(outputPath, content);

      info('  Build info written to $outputPath (commit ${buildInfo.commit}, ${buildInfo.buildType}, ${buildInfo.platform}, moon ${buildInfo.moonVersion})');
    }
    catch (e:Dynamic)
    {
      warn('  Failed to write build info: $e');
    }
  }

  function targetPlatformName():String
  {
    if (isAndroid()) return 'android';
    if (isIOS()) return 'ios';
    if (isWeb()) return 'web';
    if (isMobile()) return 'mobile';
    if (isLinux()) return 'linux';
    return 'desktop';
  }

  function configureIcons():Void
  {
    info('Configuring application icons...');

    if (isAndroid())
    {
      requireIconPath(ANDROID_ICON_DIR, 'Android adaptive icon');
      adaptiveIcon = new AdaptiveIcon(ANDROID_ICON_DIR, true);
    }
    else if (isIOS())
    {
      requireIconPath(ICON_MOBILE, 'iOS icon');

      for (size in IOS_ICON_SIZES)
      {
        addIcon(ICON_MOBILE, size);
      }

      addIcon(ICON_MOBILE);
    }
    else
    {
      requireIconPath(ICON_DESKTOP, 'Desktop icon');

      for (size in DESKTOP_ICON_SIZES)
      {
        addIcon(ICON_DESKTOP, size);
      }

      addIcon(ICON_DESKTOP);
    }

    info('Done configuring icons.');
  }

  function requireIconPath(path:String, label:String):Void
  {
    if (!FileSystem.exists(path))
    {
      error('$label path "$path" was not found. Add the icon art there before building, or the platform packager will fail later with a much less obvious error (e.g. AAPT "resource mipmap/ic_launcher not found").');
    }
  }

  function configureASTCTextures():Void
  {
    if (!(isDisplay() || isCleanCommand()) && FEATURE_COMPRESSED_TEXTURES.isEnabled(this))
    {
      readASTCExclusion();
      runASTCCompressor();
    }
  }

  function configureAdMobKeys():Void
  {
    var appId:Null<String> = envValue('ADMOB_APP_ID');

    if (appId == null)
    {
      error("ADMOB_APP_ID is not defined in the environment. Populate the .env file in your project root or build with -DNO_FEATURE_MOBILE_ADVERTISEMENTS");
      return;
    }

    setenv("ADMOB_APPID", appId);
  }

  function configureGoogleKeys():Void
  {
    if (envConfig == null)
    {
      warn("FEATURE_GOOGLE_LOGIN is enabled but no .env file was found. Google Sign-In will run without a configured client ID until GOOGLE_CLIENT_ID is set.");
      return;
    }

    var clientId:Null<String> = envValue('GOOGLE_CLIENT_ID');

    if (clientId != null)
    {
      setenv("GOOGLE_CLIENT_ID", clientId);
    }
    else
    {
      warn("GOOGLE_CLIENT_ID is not defined in the environment. Populate the .env file in your project root or build with -DNO_FEATURE_GOOGLE_LOGIN");
    }

    var clientSecret:Null<String> = envValue('GOOGLE_CLIENT_SECRET');

    if (clientSecret != null)
    {
      setenv("GOOGLE_CLIENT_SECRET", clientSecret);
    }
  }

  public function isWeb():Bool
  {
    return this.platformType == PlatformType.WEB;
  }

  public function isMobile():Bool
  {
    return this.platformType == PlatformType.MOBILE;
  }

  public function isDesktop():Bool
  {
    return this.platformType == PlatformType.DESKTOP;
  }

  public function isConsole():Bool
  {
    return this.platformType == PlatformType.CONSOLE;
  }

  public function is32Bit():Bool
  {
    return this.architectures.contains(Architecture.X86);
  }

  public function is64Bit():Bool
  {
    return this.architectures.contains(Architecture.X64);
  }

  public function isWindowsHost():Bool
  {
    return System.hostPlatform == WINDOWS;
  }

  public function isMacHost():Bool
  {
    return System.hostPlatform == MAC;
  }

  public function isLinuxHost():Bool
  {
    return System.hostPlatform == LINUX;
  }

  public function isWindows():Bool
  {
    return this.target == Platform.WINDOWS;
  }

  public function isMac():Bool
  {
    return this.target == Platform.MAC;
  }

  public function isLinux():Bool
  {
    return this.target == Platform.LINUX;
  }

  public function isAndroid():Bool
  {
    return this.target == Platform.ANDROID;
  }

  public function isIOS():Bool
  {
    return this.target == Platform.IOS;
  }

  public function isIOSSimulator():Bool
  {
    return this.target == Platform.IOS && this.targetFlags.exists("simulator");
  }

  public function isCPP():Bool
  {
    return this.defines.exists("cpp");
  }

  public function isDisplay():Bool
  {
    return this.command == "display";
  }

  public function isCleanCommand():Bool
  {
    return this.command == "clean";
  }

  public function isCleanFlag():Bool
  {
    return this.targetFlags.exists("clean");
  }

  public function isRun():Bool
  {
    return this.command == "run";
  }

  public function isInstall():Bool
  {
    return this.command == "install";
  }

  public function isBuild():Bool
  {
    return this.command == "test" || this.command == "build";
  }

  public function isDebug():Bool
  {
    return this.debug;
  }

  public function isRelease():Bool
  {
    return !isDebug();
  }

  public function isBundle():Bool
  {
    return this.targetFlags.exists("bundle") && isAndroid();
  }

  public function hasEnvironment():Bool
  {
    return envConfig != null;
  }

  public function getHaxedef(name:String):Null<Dynamic>
  {
    return this.haxedefs.get(name);
  }

  public function setHaxedef(name:String, ?value:String):Void
  {
    if (value == null) value = "";

    this.haxedefs.set(name, value);
  }

  public function unsetHaxedef(name:String):Void
  {
    this.haxedefs.remove(name);
  }

  public function getDefine(name:String):Null<Dynamic>
  {
    return this.defines.get(name);
  }

  public function hasDefine(name:String):Bool
  {
    return this.defines.exists(name);
  }

  public function addHaxelib(name:String, version:String = ""):Void
  {
    this.haxelibs.push(new Haxelib(name, version));
  }

  public function addHaxeFlag(value:String):Void
  {
    this.haxeflags.push(value);
  }

  public function addHaxeMacro(value:String):Void
  {
    addHaxeFlag('--macro ${value}');
  }

  public function addIcon(icon:String, ?size:Int):Void
  {
    this.icons.push(new Icon(icon, size));
  }

  public function addAsset(path:String, ?rename:String, ?library:String, embed:Bool = false, ?padName:String):Void
  {
    var originalPath:String = path;

    if (Path.extension(path).toLowerCase() == 'png' && FEATURE_COMPRESSED_TEXTURES.isEnabled(this))
    {
      var astcPath:String = ASTC_OUTPUT_DIR + "/" + Path.withoutExtension(path) + ".astc";

      if (!isASTCExcluded(path) && FileSystem.exists(astcPath))
      {
        path = astcPath;

        if (rename != null) rename = Path.withoutExtension(rename) + ".astc";
      }
    }

    var asset = new Asset(path, rename, null, embed, true);

    @:nullSafety(Off)
    {
      asset.library = library ?? "default";
    }

    if (padName != null && isBundle())
    {
      asset.deliveryPackName = padName;
    }

    this.assets.push(asset);
    assetOrigins.set(path, originalPath);
  }

  public function removeAsset(path:String, ?library:String):Void
  {
    var normalized:String = Path.normalize(path);

    this.assets = this.assets.filter(function(asset:Asset):Bool
    {
      if (library != null && asset.library != library) return true;

      var source:String = Path.normalize(asset.sourcePath);
      var origin:String = Path.normalize(assetOrigins.get(asset.sourcePath) ?? asset.sourcePath);

      return !(source == normalized || origin == normalized);
    });
  }

  public function addAssetPath(path:String, ?rename:String, library:String, ?include:Array<String>, ?exclude:Array<String>, embed:Bool = false,
      ?padName:String):Void
  {
    if (path == "") return;

    if (include == null) include = [];

    if (exclude == null) exclude = [];

    var targetPath:String = rename ?? path;

    if (targetPath != "") targetPath += "/";

    if (!FileSystem.exists(path))
    {
      error('Could not find asset path "${path}".');
      return;
    }
    else if (!FileSystem.isDirectory(path))
    {
      error('Could not parse asset path "${path}", expected a directory.');
      return;
    }

    var entries:Array<String> = FileSystem.readDirectory(path);
    entries.sort(Reflect.compare);

    for (file in entries)
    {
      if (FileSystem.isDirectory('${path}/${file}'))
      {
        if (this.filter(file, ["*"], exclude))
        {
          addAssetPath('${path}/${file}', '${targetPath}${file}', library, include, exclude, embed, padName);
        }
      }
      else
      {
        if (this.filter(file, include, exclude))
        {
          addAsset('${path}/${file}', '${targetPath}${file}', library, embed, padName);
        }
      }
    }
  }

  public function removeAssetPath(path:String, ?library:String):Void
  {
    if (path == "") return;

    var prefix:String = Path.addTrailingSlash(Path.normalize(path));

    this.assets = this.assets.filter(function(asset:Asset):Bool
    {
      if (library != null && asset.library != library) return true;

      var source:String = Path.normalize(asset.sourcePath);
      var origin:String = Path.normalize(assetOrigins.get(asset.sourcePath) ?? asset.sourcePath);

      return !(source.startsWith(prefix) || origin.startsWith(prefix));
    });
  }

  public function addAssetLibrary(name:String, embed:Bool = false, preload:Bool = false):Void
  {
    var sourcePath = '';
    this.libraries.push(new Library(sourcePath, name, null, embed, preload, false, ""));
  }

  public function buildCLICommand(cmd:String):CLICommand
  {
    return CommandHelper.fromSingleString(cmd);
  }

  public function buildHaxeCLICommand(path:String):CLICommand
  {
    return CommandHelper.interpretHaxe(path);
  }

  static function runGit(args:Array<String>):Null<String>
  {
    try
    {
      var process = new sys.io.Process('git', args);
      var output:String = process.stdout.readAll().toString().trim();
      var code:Null<Int> = process.exitCode();

      process.close();

      return code == 0 ? output : null;
    }
    catch (e:Dynamic)
    {
      return null;
    }
  }

  static function isGitDirty():Bool
  {
    try
    {
      var process = new sys.io.Process('git', ['diff', '--quiet']);
      var code:Null<Int> = process.exitCode();

      process.close();

      return code == 1;
    }
    catch (e:Dynamic)
    {
      return false;
    }
  }

  function gitInfo():GitInfo
  {
    var cached:Null<GitInfo> = cachedGitInfo;

    if (cached != null) return cached;

    var branch:Null<String> = runGit(['rev-parse', '--abbrev-ref', 'HEAD']);
    var commit:Null<String> = runGit(['rev-parse', 'HEAD']);
    var shortHash:Null<String> = runGit(['rev-parse', '--short=7', 'HEAD']);

    if (branch == null || commit == null)
    {
      warn('Could not read git metadata; is this a proper Git repository?');
    }

    var result:GitInfo =
      {
        branch: branch ?? 'unknown',
        commit: commit ?? 'unknown',
        shortHash: shortHash ?? 'unknown',
        modified: isGitDirty()
      };

    cachedGitInfo = result;

    return result;
  }

  public function getGitBranch():String
  {
    return gitInfo().branch;
  }

  public function getGitCommit():String
  {
    return gitInfo().shortHash;
  }

  public function getGitShortHash():String
  {
    return gitInfo().shortHash;
  }

  public function getGitModified():Bool
  {
    return gitInfo().modified;
  }

  function locateHmmFile():Null<String>
  {
    var candidates:Array<String> = [HMM_FILE, Path.join(["..", "..", "..", "..", "..", HMM_FILE])];

    for (candidate in candidates)
    {
      if (FileSystem.exists(candidate)) return candidate;
    }

    return null;
  }

  @SuppressWarnings('checkstyle:Dynamic')
  function checkLibraries():Void
  {
    var hmmPath:Null<String> = locateHmmFile();

    if (hmmPath == null)
    {
      warn('$HMM_FILE was not found; skipping dependency verification.');
      return;
    }

    var hmmData:Dynamic = haxe.Json.parse(File.getContent(hmmPath));
    var dependencies:Array<Dynamic> = cast hmmData.dependencies;
    var mismatches:Array<LibraryMismatch> = [];

    for (library in dependencies)
    {
      var libraryName:String = cast(library.name, String).replace(".", ",");
      var libraryType:String = Std.string(library.type);

      var devPath:String = readLibraryDev(libraryName);
      var currentVersion:String = readLibraryCurrentVersion(libraryName);
      var currentCommit:String = readLibraryGitCommitHash(libraryName);
      var isDevelopment:Bool = devPath != "" && !isLibraryLocalGitDev(libraryName);

      switch (libraryType)
      {
        case 'haxelib':
          if (library.version == null) continue;

          var expectedVersion:String = Std.string(library.version);

          if (isDevelopment)
          {
            mismatches.push({
              name: libraryName,
              devPath: devPath,
              current: currentCommit,
              expected: expectedVersion,
              type: libraryType
            });
          }
          else if (expectedVersion != currentVersion)
          {
            mismatches.push({
              name: libraryName,
              devPath: '',
              current: currentVersion,
              expected: expectedVersion,
              type: libraryType
            });
          }
        case 'git':
          var expectedRef:String = Std.string(library.ref);

          if (currentCommit != expectedRef)
          {
            mismatches.push({
              name: libraryName,
              devPath: isDevelopment ? devPath : '',
              current: currentCommit,
              expected: expectedRef,
              type: libraryType
            });
          }
      }
    }

    if (mismatches.length == 0) return;

    mismatches.sort(function(a:LibraryMismatch, b:LibraryMismatch):Int return Reflect.compare(a.name, b.name));

    warn("Some libraries differ from the versions defined in hmm.json.".bold().yellow());
    warn("To ensure consistency, it's recommended to stop the build and run `hmm reinstall [library]`.".bold().yellow());
    warn("If you're intentionally using development builds or newer versions, you can ignore this warning.".bold().yellow());

    Sys.println('');

    for (mismatch in mismatches)
    {
      var displayName:String = mismatch.name.replace(",", ".");

      if (Path.isAbsolute(mismatch.devPath))
      {
        Sys.println("- " + displayName + " (Development Build)".bright_cyan());
        Sys.println(("   Path:     " + Path.removeTrailingSlashes(mismatch.devPath)).bright_blue());
      }
      else
      {
        Sys.println("- " + displayName);
      }

      Sys.println(("   Current:  " + mismatch.current).red());
      Sys.println(("   Expected: " + mismatch.expected).green());
    }

    Sys.println('');
  }

  static function readLibraryFile(path:String):String
  {
    if (FileSystem.exists(path)) return File.getContent(path).trim();

    return '';
  }

  static function readLibraryCurrentVersion(libraryName:String):String
  {
    return readLibraryFile(getLibraryCurrentFile(libraryName));
  }

  static function readLibraryDev(libraryName:String):String
  {
    return readLibraryFile(getLibraryDevFile(libraryName));
  }

  static function readLibraryGitCommitHash(libraryName:String):String
  {
    var gitPath:String = getLibraryGitPath(libraryName);

    if (FileSystem.exists(gitPath))
    {
      var commit:Null<String> = runGit(["-C", gitPath, "rev-parse", "HEAD"]);

      if (commit != null && commit.length > 0) return commit;
    }

    var devPath:String = readLibraryDev(libraryName);

    if (devPath != "" && FileSystem.exists(devPath))
    {
      return runGit(["-C", devPath, "rev-parse", "HEAD"]) ?? '';
    }

    return '';
  }

  static function getLibraryFolder(libraryName:String):String
  {
    return Path.join([Path.addTrailingSlash(Sys.getCwd()), '.haxelib', libraryName]);
  }

  static function getLibraryCurrentFile(libraryName:String):String
  {
    return Path.join([getLibraryFolder(libraryName), '.current']);
  }

  static function getLibraryDevFile(libraryName:String):String
  {
    return Path.join([getLibraryFolder(libraryName), '.dev']);
  }

  static function getLibraryGitPath(libraryName:String):String
  {
    return Path.join([getLibraryFolder(libraryName), 'git']);
  }

  static function isLibraryLocalGitDev(libraryName:String):Bool
  {
    var gitPath:String = getLibraryGitPath(libraryName);
    var devFile:String = getLibraryDevFile(libraryName);

    if (FileSystem.exists(gitPath) && FileSystem.exists(devFile))
    {
      return Path.normalize(readLibraryDev(libraryName)).startsWith(gitPath);
    }

    return false;
  }

  static function getLibraryPath(libraryName:String):String
  {
    try
    {
      var process = new sys.io.Process('haxelib', ['libpath', libraryName]);
      var output:String = process.stdout.readAll().toString();

      process.close();

      return output.split("\n")[0].trim();
    }
    catch (e:Dynamic)
    {
      return "error";
    }
  }

  public function buildHxCppTools():Void
  {
    var path:String = getLibraryPath("hxcpp");

    if (path.toLowerCase().startsWith("error") || !FileSystem.exists(path))
    {
      error('HXCPP could not be found while on C++ target.');
      return;
    }

    var dotNPath:String = Path.join([path, 'hxcpp.n']);
    var toolsPath:String = Path.join([path, 'tools/hxcpp']);

    if (FileSystem.exists(dotNPath))
    {
      return;
    }

    info('Compiling the HXCPP Build Tool...');
    info(toolsPath);

    var oldDir:String = Sys.getCwd();

    try
    {
      Sys.setCwd(toolsPath);

      var compileProcess = new sys.io.Process('haxe', ['compile.hxml']);
      var exitCode:Null<Int> = compileProcess.exitCode();

      compileProcess.close();

      if (exitCode != 0)
      {
        warn('Could not compile the Build Tool. Is HXCPP installed correctly? Continuing...');
      }
      else
      {
        info('Compiled the HXCPP Build Tool successfully!');
      }
    }
    catch (e:Dynamic)
    {
      warn('Could not compile the Build Tool: $e');
    }

    Sys.setCwd(oldDir);
  }

  public function error(message:String):Void
  {
    Sys.stderr().writeString(' ERROR '.bold().bg_red() + " " + message + "\n");
    Sys.exit(1);
  }

  public function info(message:String):Void
  {
    if (!(isDisplay() || isCleanCommand() || isRun() || isInstall()))
    {
      Sys.println(' INFO '.bold().bg_blue() + " " + message);
    }
  }

  public function warn(message:String):Void
  {
    if (!(isDisplay() || isCleanCommand() || isRun() || isInstall()))
    {
      Sys.println(' WARNING '.bold().bg_yellow() + " " + message);
    }
  }

  static function envValue(key:String):Null<String>
  {
    var config:Null<Map<String, Dynamic>> = envConfig;

    if (config == null) return null;

    var value:Null<Dynamic> = config.get(key);

    if (value == null) return null;

    var text:String = Std.string(value).trim();

    return text.length == 0 ? null : text;
  }

  static function unquote(value:String):String
  {
    if (value.length >= 2)
    {
      var first:String = value.charAt(0);
      var last:String = value.charAt(value.length - 1);

      if ((first == '"' || first == "'") && first == last)
      {
        return value.substr(1, value.length - 2);
      }
    }

    return value;
  }

  public function readEnvironmentFile(file:String):Null<Map<String, Dynamic>>
  {
    if (!FileSystem.exists(file))
    {
      warn('Environment file does not exist: ${file}');
      return null;
    }

    var content:String = "";

    try
    {
      content = File.getContent(file);
    }
    catch (e:Dynamic)
    {
      warn('Failed to parse environment file: ${file}');
      return null;
    }

    var env = new Map<String, Dynamic>();

    for (rawLine in content.split('\n'))
    {
      var line:String = rawLine.trim();

      if (line.startsWith('export '))
      {
        line = line.substr(7).trim();
      }

      if (line.length <= 0 || line.startsWith('#') || shouldExcludeEnvKey(line))
      {
        continue;
      }

      var index:Int = line.indexOf('=');

      if (index == -1)
      {
        continue;
      }

      var key:String = line.substr(0, index).trim();
      var value:String = unquote(line.substr(index + 1).trim());

      if (value.length == 0)
      {
        continue;
      }

      env.set(stripEnvTargetPrefix(key), value);
    }

    return env;
  }

  public function shouldExcludeEnvKey(key:String):Bool
  {
    var android:Bool = key.startsWith('ANDROID_');
    var ios:Bool = key.startsWith('IOS_');
    var mobile:Bool = key.startsWith('MOBILE_') || ios || android;
    var web:Bool = key.startsWith('WEB_');
    var desktop:Bool = key.startsWith('DESKTOP_');

    if (isWeb() && (mobile || desktop)) return true;
    if (isDesktop() && (mobile || web)) return true;
    if (isAndroid() && (ios || web || desktop)) return true;
    if (isIOS() && (android || web || desktop)) return true;

    return false;
  }

  public function stripEnvTargetPrefix(key:String):String
  {
    var index:Int = key.indexOf('_');

    if (index == -1)
    {
      return key;
    }

    var prefix:String = key.substr(0, index);
    var rest:String = key.substr(index + 1);

    if (isAndroid() && (prefix == 'ANDROID' || prefix == 'MOBILE'))
    {
      return rest;
    }
    else if (isIOS() && (prefix == 'IOS' || prefix == 'MOBILE'))
    {
      return rest;
    }
    else if (isWeb() && prefix == 'WEB')
    {
      return rest;
    }
    else if (isDesktop() && prefix == 'DESKTOP')
    {
      return rest;
    }

    return key;
  }

  @:nullSafety(Off)
  public function readASTCExclusion():Void
  {
    if (!FileSystem.exists(ASTC_DATA_FILE))
    {
      warn('$ASTC_DATA_FILE was not found; no textures will be excluded from ASTC compression.');
      astcExcludes = [];
      return;
    }

    var data:Dynamic = haxe.Json.parse(File.getContent(ASTC_DATA_FILE));
    var excludes:Array<String> = data.excludes;

    astcExcludes = excludes != null ? excludes.map(function(entry:String):String return entry.trim()) : [];
  }

  public function isASTCExcluded(file:String):Bool
  {
    for (exclusion in astcExcludes)
    {
      if (exclusion.endsWith("/"))
      {
        var normalizedFilePath = Path.normalize(file);
        var normalizedExclusion = Path.normalize(exclusion);

        if (normalizedFilePath.startsWith(normalizedExclusion)) return true;
      }
      else if (exclusion.endsWith("/*"))
      {
        var normalizedExclusion = Path.normalize(exclusion.substr(0, exclusion.length - 2));
        var fileDirectory = Path.directory(Path.normalize(file));

        if (fileDirectory == normalizedExclusion) return true;
      }
      else
      {
        if (file == exclusion) return true;
      }
    }

    return false;
  }

  public function runASTCCompressor():Void
  {
    info('Compressing ASTC textures...');

    var args:Array<String> = ['run', 'astc-compressor', 'compress-from-json', '-json', ASTC_DATA_FILE];

    if (isCleanFlag())
    {
      args.push('-clean');
    }

    var exitCode:Int = Sys.command('haxelib', args);

    if (exitCode != 0)
    {
      warn('The ASTC compressor exited with code $exitCode.');
    }

    info('Done compressing ASTC textures.');
  }
}

abstract FeatureFlag(String) from String to String
{
  public static final INVERSE_PREFIX:String = "NO_";

  public function new(input:String)
  {
    this = input;
  }

  @:from
  public static function fromString(input:String):FeatureFlag
  {
    return new FeatureFlag(input);
  }

  public function apply(project:Project, enableByDefault:Bool = false):Void
  {
    if (isEnabled(project))
    {
      getInverse().disable(project, false);
    }
    else if (getInverse().isEnabled(project))
    {
      disable(project, false);
    }
    else
    {
      if (enableByDefault)
      {
        enable(project, true);
      }
      else
      {
        disable(project, true);
      }
    }
  }

  public function enable(project:Project, andInverse:Bool = true)
  {
    project.setHaxedef(this, "");
    if (andInverse)
    {
      getInverse().disable(project, false);
    }
  }

  public function disable(project:Project, andInverse:Bool = true)
  {
    project.unsetHaxedef(this);
    if (andInverse)
    {
      getInverse().enable(project, false);
    }
  }

  public function isEnabled(project:Project):Bool
  {
    return project.haxedefs.exists(this) || project.defines.exists(this);
  }

  public function isDisabled(project:Project):Bool
  {
    return getInverse().isEnabled(project);
  }

  public function getInverse():FeatureFlag
  {
    if (this.startsWith(INVERSE_PREFIX))
    {
      return this.substring(INVERSE_PREFIX.length);
    }
    return INVERSE_PREFIX + this;
  }
}
